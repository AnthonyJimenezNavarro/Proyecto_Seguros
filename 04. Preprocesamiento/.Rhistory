guardar_xlsx <- function(tabla, archivo) {
openxlsx::write.xlsx(
x = as.data.frame(tabla),
file = archivo,
overwrite = TRUE,
asTable = TRUE
)
}
guardar_libro_xlsx <- function(tablas, archivo) {
openxlsx::write.xlsx(
x = lapply(tablas, as.data.frame),
file = archivo,
overwrite = TRUE,
asTable = TRUE
)
}
